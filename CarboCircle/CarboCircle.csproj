<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <!-- The net48 host (Revit 2023-2024) debugs on the Desktop CLR engine, the net8.0-windows host (Revit 2025) on CoreCLR. -->
    <DebugEngines Condition="'$(TargetFramework)' == 'net48'">{351668CC-8477-4fbf-BFE3-5F1006E4DB1F}</DebugEngines>
    <DebugEngines Condition="'$(TargetFramework)' == 'net8.0-windows'">{FB0D4648-F776-4980-95F3-9A3AE0F3D2CB}</DebugEngines>
    <OutputType>Library</OutputType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <OutputPath>..\CarboLifeCalc\bin\Debug\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <OutputPath>..\CarboLifeCalc\bin\Debug\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="db\**" />
    <EmbeddedResource Remove="db\**" />
    <None Remove="db\**" />
    <Page Remove="db\**" />
  </ItemGroup>
  <ItemGroup>
    <!-- UI\Legacy holds the pre-redesign CarboCircleMain.xaml, kept so the old window can be
         restored by copying the file back over UI\CarboCircleMain.xaml. Excluded from the
         build: a second Page compiling the same x:Class would be a duplicate definition. -->
    <Compile Remove="UI\Legacy\**" />
    <EmbeddedResource Remove="UI\Legacy\**" />
    <None Remove="UI\Legacy\**" />
    <Page Remove="UI\Legacy\**" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="circledb\CarboCircleMasterSections.csv" />
    <None Remove="circledb\CarboCircleMasterSections.xlsx" />
    <None Remove="circledb\carboCircleMaterials.cxml" />
    <None Remove="circledb\CarboCircleSettings.xml" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="circledb\CarboCircleMasterSections.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="circledb\CarboCircleMasterSections.xlsx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="circledb\carboCircleMaterials.cxml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="circledb\CarboCircleSettings.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="System.Data.DataSetExtensions" Version="4.5.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CarboLifeAPI\CarboLifeAPI.csproj" />
    <ProjectReference Include="..\CarboLifeUI\CarboLifeUI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Absorbs the 32-bit/64-bit ElementId difference between Revit 2023 and 2025. -->
    <Compile Include="..\Shared\RevitCompat.cs" Link="Properties\RevitCompat.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="AdWindows">
      <HintPath>$(RevitApiDir)AdWindows.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitApiDir)RevitAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitApiDir)RevitAPIUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
</Project>
